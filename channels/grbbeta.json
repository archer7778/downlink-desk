{
  "satellite": "GRBBeta",
  "notes": "Field names come from the SatNOGS 'grbbeta' decoder. Radio beacon units (temperatures in 0.01 °C, signal level as (value/2)-134 dBm, uptime in seconds) come from the GRBBeta team's published beacon format. Power-unit scaling is NOT published: temperatures are converted assuming 1/128 K steps, which matches the radio temperatures, and battery voltage and solar input are shown as raw counts until confirmed. Limits are provisional values chosen for this console.",
  "frame_types": [
    {
      "name": "UHF beacon",
      "if_field": "uhf_uptime_total"
    },
    {
      "name": "VHF beacon",
      "if_field": "vhf_uptime_total"
    },
    {
      "name": "Power housekeeping",
      "if_field": "psu_bat_volt"
    },
    {
      "name": "CW beacon",
      "if_field": "cw_beacon"
    },
    {
      "name": "Digipeated message",
      "if_field": "digi_message"
    },
    {
      "name": "Text message",
      "if_field": "message"
    }
  ],
  "channels": [
    {
      "id": "bat_v",
      "sub": "Power",
      "name": "Battery voltage (raw count)",
      "field": "psu_bat_volt",
      "transform": "none",
      "unit": "",
      "dp": 0,
      "lim": null
    },
    {
      "id": "bat_chg",
      "sub": "Power",
      "name": "Battery charge current",
      "field": "psu_bat_amp_charge",
      "unit": "mA",
      "dp": 0,
      "lim": null
    },
    {
      "id": "bat_dis",
      "sub": "Power",
      "name": "Battery discharge current",
      "field": "psu_bat_amp_discharge",
      "unit": "mA",
      "dp": 0,
      "lim": null
    },
    {
      "id": "pv1",
      "sub": "Power",
      "name": "Solar input 1 (raw count)",
      "field": "psu_pv_in_power1",
      "unit": "",
      "dp": 0,
      "lim": null
    },
    {
      "id": "pv2",
      "sub": "Power",
      "name": "Solar input 2 (raw count)",
      "field": "psu_pv_in_power2",
      "unit": "",
      "dp": 0,
      "lim": null
    },
    {
      "id": "psu_resets",
      "sub": "Power",
      "name": "Power unit resets",
      "field": "psu_reset_cnt",
      "unit": "",
      "dp": 0,
      "lim": null,
      "counter": "reboot"
    },
    {
